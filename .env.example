# Kredensial API Polyester Testnet
# Ambil dari menu Settings / API Keys di https://testnet.polyester.com
POLYESTER_API_KEY_ID=ak_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POLYESTER_API_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POLYESTER_ACCOUNT_ID=acc_xxxxxxxxxxxxxx

# Target Pair Trading (Contoh: ETH-USDC, BTC-USDC)
TRADING_SYMBOL=ETH-USDC

# Pengaturan Trading Automation
MIN_ORDER_AMOUNT=0.01
MAX_ORDER_AMOUNT=0.05
MIN_DELAY_SECONDS=15
MAX_DELAY_SECONDS=60
TOTAL_CYCLES=50

# Batalkan open order lama sebelum buat order baru? (true/false)
AUTO_CANCEL_OPEN_ORDERS=true
